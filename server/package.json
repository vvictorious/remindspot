{
  "name": "server",
  "version": "0.0.1",
  "description": "ThereYouGo backend API",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\" \"evaluation/**/*.{ts,md,json}\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"test/**/*.ts\" \"evaluation/**/*.{ts,md,json}\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "lint": "eslint \"{src,test,evaluation}/**/*.ts\"",
    "lint:fix": "npm run lint -- --fix",
    "test": "vitest run src evaluation",
    "test:watch": "vitest src",
    "test:e2e": "vitest run test",
    "typecheck": "tsc --noEmit",
    "eval:classification": "tsc -p evaluation/tsconfig.json && node dist-evaluation/evaluation/classification/run.js",
    "eval:matching": "tsc -p evaluation/tsconfig.json && node dist-evaluation/evaluation/matching/run.js",
    "eval:classification:gemini": "tsc -p evaluation/tsconfig.json && node dist-evaluation/evaluation/classification/run-gemini.js"
  },
  "engines": {
    "node": ">=22.13"
  },
  "dependencies": {
    "@google/genai": "^2.28.0",
    "@nestjs/common": "^11.0.1",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.0.1",
    "@nestjs/platform-express": "^11.0.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.4",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.18.0",
    "@nestjs/cli": "^11.0.0",
    "@nestjs/testing": "^11.0.1",
    "@types/node": "^24.0.0",
    "@types/supertest": "^7.0.0",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-prettier": "^5.2.2",
    "globals": "^17.0.0",
    "prettier": "^3.4.2",
    "supertest": "^7.0.0",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.20.0",
    "vitest": "^5.0.3"
  }
}
